#cloud-config
# Raspberry Pi OS Imager "OS Customization" -> "Advanced options" -> paste this
# as user-data (or the equivalent first-boot script field), one copy per node.
#
# Fill in the placeholders below before flashing each SD card:
#   <PI4_LOCAL_IP>        - the Pi 4's reserved DHCP IP (see plan.md step 2)
#   <CLUSTER_SSH_PRIVATE_KEY> - contents of the shared cluster keypair's private key
#                               (see rpi-cluster-ansible/README.md - generate once,
#                               reuse across all three nodes, never commit it to git)
#   <CLUSTER_SSH_PUBLIC_KEY>  - the matching .pub file contents
#   ssh_authorized_keys      - add your own login key under a `users:` section
#                              (see rpi-cluster-ansible/README.md) - Raspberry Pi
#                              OS ships the ssh service DISABLED by default, so
#                              this file must also explicitly enable it (see
#                              runcmd below) or you will never be able to log in
#                              no matter how long you wait.
#   <CONSOLE_FALLBACK_PASSWORD_HASH> - a SHA-512 crypt hash (openssl passwd -6)
#                              for a physical-console login fallback, in case
#                              ssh/networking never comes up and you need to
#                              type directly into the Pi (keyboard/HDMI or a
#                              BadUSB-style HID injector). Keep the plaintext
#                              password out of git - see .pi4-console-fallback-password.

users:
  - name: master
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    passwd: <CONSOLE_FALLBACK_PASSWORD_HASH>
    ssh_authorized_keys:
      - <YOUR_SSH_PUBLIC_KEY>

write_files:
  - path: /etc/rpi-cluster/id_ed25519
    permissions: "0600"
    owner: root:root
    content: |
      <CLUSTER_SSH_PRIVATE_KEY>
  - path: /etc/rpi-cluster/id_ed25519.pub
    permissions: "0644"
    owner: root:root
    content: |
      <CLUSTER_SSH_PUBLIC_KEY>

runcmd:
  # Raspberry Pi OS ships sshd disabled by default - enable it explicitly.
  - systemctl enable --now ssh
  - exec > /var/log/firstrun-ansible.log 2>&1
  - apt-get update
  # ansible-core (not the full "ansible" metapackage) avoids pulling in
  # Windows-remoting extras (python3-winrm/xmltodict/kerberos) we don't need
  # and that have been known to 404 on the Debian trixie mirror.
  - apt-get install -y --no-install-recommends ansible-core git
  - ansible-galaxy collection install community.general ansible.posix
  # NOTE: -d specifies the checkout directory, NOT a subdirectory to look for
  # the playbook in - the playbook path below is relative to the repo root.
  - >
    ansible-pull -U https://github.com/Miro-Ali-Akbar/pi-cluster.git
    -i localhost, rpi-cluster-ansible/local.yml
    --extra-vars "pi4_local_ip=<PI4_LOCAL_IP>"
